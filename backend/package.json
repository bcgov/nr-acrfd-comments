    "qs": "6.14.2",
    "reproject": "1.2.4",
    "stream": "0.0.2",
    "swagger-tools": "0.10.4",
    "underscore": "^1.13.7",
    "validator": "^13.15.26",
    "winston": "2.4.4",
    "wkx": "0.4.7",
    "yamljs": "0.3.0"
