  "main": "app",
  "scripts": {
    "start": "node app",
    "dev": "node app",
    "test": "echo Test suite should be run with `npm run tests` or `npm run tests-ci`",
    "tests": "UPLOAD_DIRECTORY=./api/test/uploads/ jest --runInBand",
    "tests-ci": "UPLOAD_DIRECTORY=./api/test/uploads/ jest --runInBand --coverage",
    "test:cov": "npm run tests-ci",
    "tests-debug": "node --inspect node_modules/.bin/jest --runInBand",
    "lint": "eslint .",
    "lint-fix:1": "eslint ./**/*.js --fix",
    "lint-fix:2": "prettier ./**/*.js --write --loglevel warn",
    "lint-fix": "npm-run-all -l -s -c lint-fix:*",
    "migrate": "db-migrate up",
    "migrate:down": "db-migrate down",
    "seed": "node seed/index.js"
  },
  "engines": {
    "node": ">= 10.0.0",
    "npm": ">= 6.0.0"
  },
  "dependencies": {
    "@turf/helpers": "6.1.4",
